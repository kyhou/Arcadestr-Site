---
// Pixel-grid cabinet mark (18×23 native). Render only at whole multiples so pixels stay even.
interface Props { scale?: 1 | 2 | 3; class?: string }
const { scale = 2, class: cls = '' } = Astro.props;
---
<img src="/icons/arcadestr-mark.svg" width={18 * scale} height={23 * scale} alt="" class={cls} style="image-rendering: pixelated" />

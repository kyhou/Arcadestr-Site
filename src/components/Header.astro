---
import Logo from './Logo.astro';
import { site } from '../config';

const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/#developers', label: 'Developers' },
  { href: '/protocol/', label: 'Protocol' },
  { href: '/#faq', label: 'FAQ' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-5">
    <a href="/" class="flex items-center gap-2.5 font-mono font-semibold tracking-wide">
      <Logo size={32} />
      <span>{site.name.toUpperCase()}</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 font-mono text-sm text-muted" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} class:list={['hover:text-fg transition-colors', path.startsWith(n.href) && n.href !== '/' && 'text-fg']}>
          {n.label}
        </a>
      ))}
    </nav>
    <a href="/download/" class="btn btn-primary ml-auto !py-2 !px-4 text-sm">Download</a>
  </div>
</header>

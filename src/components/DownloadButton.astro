---
// Renders a generic link to /download/ (works without JS), then upgrades itself
// client-side to the visitor's OS installer when a release asset exists.
import { getLatestRelease, primaryByOs } from '../lib/releases';
import { site } from '../config';

interface Props { size?: 'lg' | 'md' }
const { size = 'lg' } = Astro.props;
const release = await getLatestRelease();
const availablePlatforms = Object.entries(site.platforms)
  .filter(([os]) => release?.assets.some((asset) => asset.os === os))
  .map(([, platform]) => platform.label);
const primaries = Object.fromEntries(
  Object.entries(primaryByOs(release?.assets ?? [])).map(([os, asset]) => [os, { url: asset.url, kind: asset.kind }]),
);
const payload = JSON.stringify({
  version: release?.version ?? null,
  assets: primaries,
  labels: Object.fromEntries(Object.entries(site.platforms).map(([k, v]) => [k, v.label])),
});
---

<div class="download-cta inline-flex flex-col gap-2" data-release={payload}>
  <a href="/download/" class:list={['btn btn-primary', size === 'lg' && 'text-base !px-6 !py-3.5']} data-btn>
    <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v10m0 0 4-4m-4 4L4 7M2 14h12" stroke="currentColor" stroke-width="2"/></svg>
    <span data-label>{release ? `Download v${release.version}` : 'Get Arcadestr'}</span>
  </a>
  <span class="label" data-note>{availablePlatforms.join(' · ') || 'First release coming soon'}</span>
</div>

<script>
  import { detectOs } from '../lib/detect-os';

  for (const el of document.querySelectorAll<HTMLElement>('.download-cta')) {
    const data = JSON.parse(el.dataset.release!);
    const os = detectOs();
    const btn = el.querySelector<HTMLAnchorElement>('[data-btn]')!;
    const label = el.querySelector<HTMLElement>('[data-label]')!;
    const note = el.querySelector<HTMLElement>('[data-note]')!;
    if (!os || !data.version) continue;
    const asset = data.assets[os];
    if (asset) {
      btn.href = asset.url;
      label.textContent = `Download for ${data.labels[os]}`;
      note.innerHTML = `v${data.version} · ${asset.kind} · <a class="underline hover:text-fg" href="/download/">other platforms</a>`;
    } else {
      note.innerHTML = `Not yet available for ${data.labels[os]} · <a class="underline hover:text-fg" href="/download/">see platforms</a>`;
    }
  }
</script>
